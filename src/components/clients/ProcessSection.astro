---
import defaults from '../../data/launchDefaults.json';
const {steps=defaults.processSteps,title='Our Process'}=Astro.props;
---
<section class="process-editorial">
 <h2 data-reveal>{title}</h2>
 <ol>{steps.map((step,index)=><li data-reveal="process"><span class="process-number" aria-hidden="true">{index+1}</span><h3><span>{step.title.split(" ").slice(0,-1).join(" ")}</span>{" "}<span>{step.title.split(" ").slice(-1)}</span></h3><p>{step.description}</p></li>)}</ol>
</section>
