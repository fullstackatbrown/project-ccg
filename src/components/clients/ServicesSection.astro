---
const { services } = Astro.props;
---
<!-- Our Services Section with Glass Morphism -->
<section class="client-services w-full py-24 bg-gradient-to-r from-[#173884] to-[#8d0428] text-white relative overflow-hidden">

    <div class="container mx-auto px-4 text-center relative z-10 fade-in">
        <h1 class="text-5xl md:text-7xl font-bold mb-8" style="font-family: 'Aileron', sans-serif;">Our Services</h1>
    
        
        <div class="flex items-center justify-center mb-12 mt-4 fade-in-delay-1">
        <div class="w-12 h-1 bg-red-700"></div>
          <div class="w-3 h-3 rounded-full bg-red-700 ml-1"></div>
          <div class="w-12 h-1 bg-red-700 ml-1"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 fade-in-delay-2">

        <!-- Services start here -->
        {services.map(service => (
            <div class="service-card flex flex-col items-center p-8 bg-white/10 rounded-xl" data-reveal>
              <div class="bg-white/20 w-20 h-20 rounded-full flex items-center justify-center mb-6">
                <img src={`https:${service.imageUrl}`} alt={service.title} class="h-12" />
              </div>
              <h3 class="text-2xl font-bold mb-3 text-white">{service.title}</h3>
              <p class="text-white/90">{service.description}</p>
            </div>
          ))}

       
        </div>
    </div>
</section>