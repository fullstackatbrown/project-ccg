---
const { services } = Astro.props;
---
<section class="capabilities-section" aria-labelledby="capabilities-title">
 <div class="capabilities-intro" data-reveal>
  <h2 id="capabilities-title">What can CCG<br />help you solve?</h2>
  <a class="feature-link" href="/contact">Discuss a project <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
 </div>
 <div class="capability-list">
  {services.map((service,index)=><details class="capability" open={index===0}>
   <summary><h3>{service.title}</h3><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5v14"/></svg></summary>
   <div class="capability-description"><p>{service.description}</p></div>
  </details>)}
 </div>
</section>
