---
const {values,title='Our Values',image='/assets/images/smallgroup.jpeg'}=Astro.props;
---
<section id="learn-more" class="approach-section">
 <div class="approach-intro"><h2 data-reveal>{title}</h2><div class="approach-photo" data-reveal="image"><img src={image} alt="CCG members on campus" loading="lazy" /></div></div>
 <div class="approach-composition">
  <div class="approach-cards">{values.map(value=><article class="approach-card" data-reveal>
   <div class="approach-icon" aria-hidden="true" set:html={value.iconSvg}></div>
   <h3>{value.title}</h3><p>{value.description}</p>
  </article>)}</div>
 </div>
</section>
