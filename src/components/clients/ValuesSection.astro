---
const {values} = Astro.props;
---
<section id="learn-more" class="values-editorial">
 <div class="values-heading" data-reveal><h2>How CCG<br />approaches<br />your work.</h2></div>
 <div class="values-copy">
  {values.map(value=><article data-reveal><h3>{value.title}</h3><p>{value.description}</p></article>)}
 </div>
</section>
