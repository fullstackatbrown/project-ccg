---
const { projects=[] } = Astro.props;
const names=['Adobe','Github','UNDP'];
const featured=names.map(name=>projects.find(project=>project.companyName?.toLowerCase()===name.toLowerCase())).filter(Boolean);
---
{featured.length>0 && <section id="selected-work" class="work-story" data-scroll-story aria-labelledby="selected-work-title">
 <div class="story-stage">
  <div class="story-navigation">
   <h2 id="selected-work-title">Selected<br />engagements.</h2>
   <div class="story-choices" role="group" aria-label="Explore selected engagements">
    {featured.map((project,index)=><button type="button" data-story-choice={index} aria-pressed={index===0}><span>{project.companyName==='Github'?'GitHub':project.companyName}</span><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button>)}
   </div>
   <a class="text-link" href="/clients">Explore all client work <span aria-hidden="true">↗</span></a>
  </div>
  <div class="story-panels">
   {featured.map((project,index)=><article class="story-panel" data-story-panel={index}>
    <div class="work-logo"><img src={project.logo} alt={project.companyName==='Github'?'GitHub':project.companyName} loading="lazy" /></div>
    <h3>{project.companyName==='Github'?'GitHub':project.companyName}</h3>
    <p>{project.summary||project.description}</p>
    <a href="/clients#client-projects" class="work-link">More about our engagements <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a>
   </article>)}
  </div>
  <div class="story-progress" aria-hidden="true"><span></span></div>
 </div>
</section>}
