---
const {projects} = Astro.props;
---
<dialog class="engagement-dialog" id="engagement-details" aria-labelledby="engagement-dialog-title" aria-describedby="engagement-dialog-description">
 <div class="engagement-dialog-shell">
  <header class="engagement-dialog-bar"><span>Client Engagement</span><button type="button" data-project-close aria-label="Close project details" autofocus><svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 6 12 12M6 18 18 6"/></svg></button></header>
  <div data-project-content></div>
 </div>
</dialog>
{projects.map(project=><template data-project-template={project.id}>
 <div class="engagement-dialog-brand">{project.logo ? <img src={project.logo} alt="" class:list={{'engagement-mark-trevor':/trevor/i.test(project.companyName)}} /> : <span class="engagement-wordmark">{project.companyName}</span>}</div>
 <div class="engagement-dialog-copy"><h2 id="engagement-dialog-title">{project.companyName}</h2>{project.semester && <p class="engagement-semester">{project.semester}</p>}<div id="engagement-dialog-description"><p>{project.description || project.summary}</p></div></div>
</template>)}
<script>
 import '../../scripts/projectDetails';
</script>
