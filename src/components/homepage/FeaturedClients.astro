---
import ProjectCard from '../portfolio/ProjectCard.astro';
const {portfolio, editorial} = Astro.props;
const home = editorial.home;
const clients = portfolio.featured;
---
{clients.length > 0 && <section id="featured-clients" class="featured-clients" aria-labelledby="featured-clients-title">
 <div class="featured-clients-stage"><div class="featured-clients-inner">
  <div class="featured-clients-intro" data-reveal>
   <h2 id="featured-clients-title">{home.featuredTitle ?? editorial.defaults.featuredTitle}</h2>
   <div><p>{home.featuredDescription ?? editorial.defaults.featuredDescription}</p><a href="/clients" class="featured-clients-link">{home.featuredLinkLabel ?? editorial.defaults.featuredLinkLabel} <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
  </div>
  <div class="featured-client-portfolio" aria-label="A selection of past client engagements">
   {clients.map(project => <ProjectCard project={project} context="featured" />)}
  </div>
 </div>
 </div>
</section>}
