---
const { projects = [] } = Astro.props;
const selection = [
  { match: 'adobe', name: 'Adobe' },
  { match: 'uber', name: 'Uber' },
  { match: 'ibm', name: 'IBM' },
  { match: 'github', name: 'GitHub' },
  { match: 'wholefoods', name: 'Whole Foods' },
  { match: 'grammarly', name: 'Grammarly' },
  { match: 'cava', name: 'CAVA' },
  { match: 'undp', name: 'United Nations Development Programme' },
];
const normalize = (name: string) => name.toLowerCase().replace(/[^a-z]/g, '');
const clients = selection.map(client => ({ ...client, project: projects.find(project => normalize(project.companyName || '') === client.match || (client.match === 'undp' && /united nations/i.test(project.companyName || ''))) })).filter(client => client.project?.logo);
---
{clients.length > 0 && <section id="featured-clients" class="featured-clients" aria-labelledby="featured-clients-title">
 <div class="featured-clients-inner">
  <div class="featured-clients-intro" data-reveal>
   <h2 id="featured-clients-title">Selected client engagements</h2>
   <div><p>CCG brings Brown’s interdisciplinary thinking to organizations at every scale—from household names in technology and retail to international development institutions.</p><a href="/clients" class="featured-clients-link">Explore our client work <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
  </div>
  <div class="featured-client-portfolio" aria-label="Selected past and current clients">
   {clients.map(client=><a href="/clients#selected-work" class="featured-client" aria-label={`Explore CCG's client work, including ${client.name}`} data-reveal><img src={client.project.logo} alt={client.name} loading="lazy" /><svg class="featured-client-arrow" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 17 17 7M7 7h10v10"/></svg></a>)}
  </div>
 </div>
</section>}
