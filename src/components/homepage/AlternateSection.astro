---
const { ourTeamImage } = Astro.props;
const { ourServicesImage } = Astro.props;
const { servicesDescription } = Astro.props;
const { teamDescription } = Astro.props;
---
<section class="home-features w-full bg-gray-50 text-black overflow-hidden">
    <div class="w-full">
        <!-- Section 1: Services (Text Left, Image Right) -->
        <div class="flex flex-col md:flex-row items-stretch">
            <div class="w-full md:w-1/2 p-8 md:p-16 lg:p-24 flex flex-col justify-center bg-white slide-in-left">
            <h2 class="text-5xl md:text-6xl font-bold mb-8 text-[#8d0428] text-left" style="font-family: 'Aileron', sans-serif;">Our Clients</h2>
            <div class="flex items-center justify-start mb-6">
                <div class="w-10 h-1 bg-[#8d0428]"></div>
                <div class="w-2 h-2 rounded-full bg-[#8d0428] ml-1"></div>
                <div class="w-10 h-1 bg-[#8d0428] ml-1"></div>
            </div>
                <p class="text-lg text-gray-800 leading-relaxed">
                    {servicesDescription}
                </p>
                <div class="mt-8 flex justify-start">
                    <a href={`/clients`} class="inline-flex items-center px-8 py-3 bg-gradient-to-r from-[#8d0428] to-[#6d0320] text-white font-medium rounded-full hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300">
                        View Past Clients
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </div>
            </div>
            <div class="w-full md:w-1/2 min-h-[200px] md:min-h-[500px] overflow-hidden scale-in relative group">
                <img src={ourServicesImage[0]}  alt="Services" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                <div class="absolute inset-0 bg-gradient-to-br from-[#8d0428]/5 to-[#8d0428]/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>
        </div>
        
        <!-- Section 2: Team (Text Right, Image Left) -->
        <div class="flex flex-col md:flex-row-reverse items-stretch">
            <div class="w-full md:w-1/2 p-8 md:p-16 lg:p-24 flex flex-col justify-center slide-in-right">
            <h2 class="text-5xl md:text-6xl font-bold mb-8 text-[#8d0428] text-left" style="font-family: 'Aileron', sans-serif;">Our Team</h2>
            <div class="flex items-center justify-start mb-6">
                <div class="w-10 h-1 bg-[#8d0428]"></div>
                <div class="w-2 h-2 rounded-full bg-[#8d0428] ml-1"></div>
                <div class="w-10 h-1 bg-[#8d0428] ml-1"></div>
            </div>
                <p class="text-lg text-gray-800 leading-relaxed">
                   {teamDescription}
                </p>
                <div class="mt-8 flex justify-start">
                    <a href={`/members`} class="inline-flex items-center px-8 py-3 bg-gradient-to-r from-[#8d0428] to-[#6d0320] text-white font-medium rounded-full hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300">
                        Meet Our Team
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </div>
            </div>
            <div class="w-full md:w-1/2 min-h-[200px] md:min-h-[500px] bg-white overflow-hidden scale-in relative group">
                <img src={ourTeamImage[0]}  alt="Our Team" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105">
                <div class="absolute inset-0 bg-gradient-to-br from-[#8d0428]/5 to-[#8d0428]/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>
        </div>
    </div>
</section>

<style>
    .scale-in {
        opacity: 0;
        transform: scale(0.95);
        animation: scaleIn 0.8s ease forwards;
    }
    
    .slide-in-left {
        opacity: 0;
        transform: translateX(-50px);
        animation: slideInLeft 0.8s ease forwards;
    }
    
    .slide-in-right {
        opacity: 0;
        transform: translateX(50px);
        animation: slideInRight 0.8s ease forwards;
    }
    
    @keyframes scaleIn {
        to {
            opacity: 1;
            transform: scale(1);
        }
    }
    
    @keyframes slideInLeft {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
    
    @keyframes slideInRight {
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }
</style>