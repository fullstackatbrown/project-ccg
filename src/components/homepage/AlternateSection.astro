---
const {ourTeamImage,ourServicesImage,servicesDescription,teamDescription,section='all'} = Astro.props;
---
<section class="home-features" aria-label={section==='team'?'Our team':'Our clients'}>
 {section!=='team' && <div class="feature-row">
  <div class="feature-copy" data-reveal>
   <h2>Our Clients</h2><p>{servicesDescription}</p>
   <a href="/clients" class="feature-link">View Past Clients <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
  </div>
  <div class="feature-image" data-reveal="image"><img src={ourServicesImage[0]} alt="CCG consultants on campus" loading="lazy" /></div>
 </div>}
 {section!=='clients' && <div class="feature-row feature-row-reverse">
  <div class="feature-copy" data-reveal>
   <h2>Our Team</h2><p>{teamDescription}</p>
   <a href="/members" class="feature-link">Meet Our Team <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
  </div>
  <div class="feature-image" data-reveal="image"><img src={ourTeamImage[0]} alt="The Collegiate Consulting Group team" loading="lazy" /></div>
 </div>}
</section>
