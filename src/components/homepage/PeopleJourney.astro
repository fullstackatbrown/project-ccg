---
import { alumniEmployers } from "../../data/alumniEmployers";
const {clubDescription,statBoxes,teamDescription,ourTeamImage}=Astro.props;
---
<section id="who-we-are" class="work-story people-journey" data-scroll-story aria-label="Meet Collegiate Consulting Group">
 <div class="story-stage">
  <div class="story-panels journey-panels">
   <article class="story-panel journey-panel" data-story-panel="0">
    <h2>Who We Are</h2>
    <div class="journey-overview">
     <div class="journey-description" set:html={clubDescription}></div>
     <dl class="club-stats journey-stats">{statBoxes.map(box=><div><dt>{box.label}</dt><dd>{box.value}</dd></div>)}</dl>
    </div>
   </article>
   <article class="story-panel journey-panel" data-story-panel="1">
    <h2>Our Team</h2>
    <div class="journey-team">
     <div class="team-photo-frame"><img src={ourTeamImage[0]} alt="Collegiate Consulting Group members" loading="lazy" /></div>
     <div><p>{teamDescription}</p><a href="/members" class="feature-link">Meet Our Team <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a></div>
    </div>
   </article>
   <article class="story-panel journey-panel" data-story-panel="2">
    <h2>Where We End Up</h2>
    <p class="journey-alumni-description">Our alumni have gone on to build successful careers at leading firms across industries.</p>
    <div class="journey-companies">{alumniEmployers.map(employer=><div class="company-logo" title={employer.name}><img src={employer.logo} alt={employer.name} class:list={{"logo-darken":employer.darken}} loading="lazy" /></div>)}</div>
   </article>
  </div>
  <div class="story-choices journey-choices" role="group" aria-label="Explore CCG">
   {['Who We Are','Our Team','Where We End Up'].map((name,index)=><button type="button" data-story-choice={index} aria-pressed={index===0}>{name}</button>)}
  </div>
  <div class="story-progress" aria-hidden="true"><span></span></div>
 </div>
</section>
