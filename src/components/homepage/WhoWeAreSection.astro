---
const {statBoxes, clubDescription} = Astro.props;
---
<section id="who-we-are" class="intro-section">
  <div class="intro-copy">
    <h1>Who We Are</h1>
    <div class="intro-description" set:html={clubDescription}></div>
  </div>
  <dl class="club-stats">
    {statBoxes.map(box => <div><dt>{box.label}</dt><dd>{box.value}</dd></div>)}
  </dl>
</section>
