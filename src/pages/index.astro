---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import HeroSection from '../components/homepage/HeroSection.astro';
import AnnualReportSection from '../components/common/AnnualReportSection.astro';
import '../styles/global.css';
import PeopleJourney from '../components/homepage/PeopleJourney.astro';
import FeaturedClients from '../components/homepage/FeaturedClients.astro';
import { fetchClients } from '../../contentfulStatic.js';
import { preparePortfolio } from '../lib/portfolio';
import ProjectDetails from '../components/portfolio/ProjectDetails.astro';
import { loadEditorial } from '../lib/editorial';
const editorial = await loadEditorial();
const projects = await fetchClients();
const portfolio = preparePortfolio(projects, editorial);
import { contentfulClient } from "../lib/contentful";


const entries2 = await contentfulClient.getEntries({
  content_type: "images"
});

const heroImage = entries2.items
  .filter(entry => entry.fields.title === "Home - Main Image")[0]
  ?.fields?.images?.map(image => image.fields?.file?.url) || [];

const ourTeamImage = entries2.items
  .filter(entry => entry.fields.title === "Home - Our Team")[0]
  ?.fields?.images?.map(image => image.fields?.file?.url) || [];

const homepage = editorial.home;
const clubDescription = editorial.migrated ? homepage.clubDescription : editorial.defaults.introduction;
const statBoxesRaw = homepage.whoWeAreStats || '';
const teamDescription = homepage.ourTeamDescription || '';

const statBoxes = statBoxesRaw
  .split('\n')
  .map(line => {
    const [value, label] = line.split(' - ').map(part => part.trim());
    return { value, label };
  })
  .filter(box => box.value && box.label);
---

<Layout>
  <div class="flex flex-col min-h-screen">
    <Navbar />
    <HeroSection heroImage={heroImage} />
    <FeaturedClients portfolio={portfolio} editorial={editorial} />
    <PeopleJourney clubDescription={clubDescription} statBoxes={statBoxes} teamDescription={teamDescription} ourTeamImage={ourTeamImage} editorial={editorial} />
    <AnnualReportSection />
    <ProjectDetails projects={portfolio.projects} />
    <Footer />
  </div>
</Layout>
